PORT=3000
AUTH_SECRET=replace-with-a-random-secret
TELEGRAM_BOT_TOKEN=replace-with-your-bot-token
TELEGRAM_CHANNEL_ID=-1001234567890
REDIS_HOST=localhost
REDIS_PORT=6379
COOKIES_PATH=./cookies.txt
DOWNLOAD_PATH=./downloads
# Timeout for the complete single-pass download of one post.
DOWNLOAD_TIMEOUT_MS=600000
SHUTDOWN_TIMEOUT_MS=30000
INSTAGRAM_MIN_INTERVAL_MS=60000
# Delay between API requests within a post; seconds.
INSTAGRAM_REQUEST_INTERVAL_SECONDS=10
# Shared delay after rate limiting; milliseconds, preserved in Redis.
INSTAGRAM_RATE_LIMIT_COOLDOWN_MS=3600000
# Local cookie-file checks during authentication pauses; milliseconds.
INSTAGRAM_COOKIES_POLL_MS=30000
# Retry metadata-failed tasks at startup and once per hour; 0 disables it.
INSTAGRAM_METADATA_RETRY_INTERVAL_MS=3600000
